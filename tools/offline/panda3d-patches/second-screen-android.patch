+    // The second screen of a dual-screen handheld (such as the AYN Thor).
+    // The game draws its picture for it (Python, in an offscreen buffer) and
+    // hands it over here; it is shown on the second display through a
+    // Presentation, and the touches on it are queued for the game to read.
+    private Presentation secondScreen = null;
+    private FrameLayout secondScreenFrame = null;
+    private ImageView secondScreenView = null;
+    private volatile boolean secondScreenOpening = false;
+    private volatile int secondScreenWidth = 0;
+    private volatile int secondScreenHeight = 0;
+    private final Bitmap[] secondScreenBitmaps = new Bitmap[2];
+    private int secondScreenBitmap = 0;
+    private final ConcurrentLinkedQueue<String> secondScreenTouches = new ConcurrentLinkedQueue<String>();
+
+    // "width height" of the second screen, or "" if there is none (yet).
+    // Asking also opens it, the first time it is there.
+    public String getSecondScreen() {
+        if (secondScreen == null && !secondScreenOpening) {
+            secondScreenOpening = true;
+            runOnUiThread(() -> {
+                try {
+                    openSecondScreen();
+                } catch (Exception e) {
+                    secondScreen = null;
+                }
+                secondScreenOpening = false;
+            });
+        }
+        int width = secondScreenWidth;
+        int height = secondScreenHeight;
+        return width > 0 && height > 0 ? width + " " + height : "";
+    }
+
+    private void openSecondScreen() {
+        DisplayManager manager = (DisplayManager) getSystemService(Context.DISPLAY_SERVICE);
+        if (manager == null) {
+            return;
+        }
+        Display[] displays = manager.getDisplays(DisplayManager.DISPLAY_CATEGORY_PRESENTATION);
+        if (displays == null || displays.length == 0) {
+            return;
+        }
+        Display display = displays[0];
+        Presentation presentation = new Presentation(this, display);
+        Context context = presentation.getContext();
+        FrameLayout frame = new FrameLayout(context);
+        frame.setBackgroundColor(0xff6eabdb);
+        ImageView view = new ImageView(context);
+        view.setScaleType(ImageView.ScaleType.FIT_XY);
+        // Panda's pictures are stored bottom row first.
+        view.setScaleY(-1f);
+        frame.addView(view, new FrameLayout.LayoutParams(
+            ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        frame.setOnTouchListener((v, event) -> {
+            int width = v.getWidth();
+            int height = v.getHeight();
+            if (width <= 0 || height <= 0) {
+                return true;
+            }
+            String kind;
+            switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                kind = "down";
+                break;
+            case MotionEvent.ACTION_MOVE:
+                kind = "move";
+                break;
+            case MotionEvent.ACTION_UP:
+                kind = "up";
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                kind = "cancel";
+                break;
+            default:
+                return true;
+            }
+            secondScreenTouches.add(kind + " " + (event.getX() / width) + " " + (event.getY() / height));
+            return true;
+        });
+        presentation.setContentView(frame);
+        presentation.getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        presentation.setOnDismissListener(dialog -> {
+            if (secondScreen == dialog) {
+                secondScreen = null;
+                secondScreenFrame = null;
+                secondScreenView = null;
+                secondScreenWidth = 0;
+                secondScreenHeight = 0;
+            }
+        });
+        presentation.show();
+        DisplayMetrics metrics = new DisplayMetrics();
+        display.getRealMetrics(metrics);
+        secondScreen = presentation;
+        secondScreenFrame = frame;
+        secondScreenView = view;
+        secondScreenWidth = metrics.widthPixels;
+        secondScreenHeight = metrics.heightPixels;
+    }
+
+    // A new picture for the second screen: RGBA rows, bottom row first.
+    public void setSecondScreenFrame(byte[] pixels, int width, int height) {
+        if (secondScreen == null || pixels.length < width * height * 4) {
+            return;
+        }
+        // Two bitmaps, so the one being shown is never the one being filled.
+        secondScreenBitmap = 1 - secondScreenBitmap;
+        Bitmap bitmap = secondScreenBitmaps[secondScreenBitmap];
+        if (bitmap == null || bitmap.getWidth() != width || bitmap.getHeight() != height) {
+            bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+            secondScreenBitmaps[secondScreenBitmap] = bitmap;
+        }
+        bitmap.copyPixelsFromBuffer(ByteBuffer.wrap(pixels, 0, width * height * 4));
+        final Bitmap shown = bitmap;
+        runOnUiThread(() -> {
+            if (secondScreenView != null) {
+                secondScreenView.setImageBitmap(shown);
+            }
+        });
+    }
+
+    // The next touch on the second screen ("down|move|up|cancel x y", x and
+    // y from 0 to 1 from the top left), or null.
+    public String pollSecondScreenTouch() {
+        return secondScreenTouches.poll();
+    }
+
+    private void closeSecondScreen() {
+        if (secondScreen != null) {
+            try {
+                secondScreen.dismiss();
+            } catch (Exception e) {
+            }
+        }
+        secondScreen = null;
+        secondScreenFrame = null;
+        secondScreenView = null;
+        secondScreenWidth = 0;
+        secondScreenHeight = 0;
+    }
+
+    @Override
+    protected void onStop() {
+        closeSecondScreen();
+        super.onStop();
+    }
