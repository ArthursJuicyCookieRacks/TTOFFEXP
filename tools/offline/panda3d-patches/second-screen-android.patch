+/**
+ * Returns (width, height) of the second screen of a dual-screen device, or
+ * None if there is none (yet).  The first call opens it.
+ */
+static PyObject *
+_py_second_screen(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "getSecondScreen", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    Py_RETURN_NONE;
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (result == nullptr) {
+    Py_RETURN_NONE;
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  int width = 0, height = 0;
+  bool found = sscanf(chars, "%d %d", &width, &height) == 2 && width > 0 && height > 0;
+  env->ReleaseStringUTFChars(result, chars);
+  env->DeleteLocalRef(result);
+  if (!found) {
+    Py_RETURN_NONE;
+  }
+  return Py_BuildValue("(ii)", width, height);
+}
+
+/**
+ * Shows a picture on the second screen: RGBA bytes, bottom row first.
+ */
+static PyObject *
+_py_second_screen_frame(PyObject *self, PyObject *args) {
+  Py_buffer pixels;
+  int width, height;
+  if (!PyArg_ParseTuple(args, "y*ii", &pixels, &width, &height)) {
+    return NULL;
+  }
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "setSecondScreenFrame", "([BII)V") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    PyBuffer_Release(&pixels);
+    Py_RETURN_NONE;
+  }
+  jbyteArray array = env->NewByteArray((jsize)pixels.len);
+  if (array != nullptr) {
+    env->SetByteArrayRegion(array, 0, (jsize)pixels.len, (const jbyte *)pixels.buf);
+    env->CallVoidMethod(activity, method, array, width, height);
+    env->DeleteLocalRef(array);
+  }
+  env->ExceptionClear();
+  env->DeleteLocalRef(activity_class);
+  PyBuffer_Release(&pixels);
+  Py_RETURN_NONE;
+}
+
+/**
+ * Returns the next touch on the second screen, as (kind, x, y) with x and y
+ * from 0 to 1 from the top left, or None.
+ */
+static PyObject *
+_py_second_screen_touch(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "pollSecondScreenTouch", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    Py_RETURN_NONE;
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (result == nullptr) {
+    Py_RETURN_NONE;
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  char kind[16] = {0};
+  float x = 0, y = 0;
+  bool found = sscanf(chars, "%15s %f %f", kind, &x, &y) == 3;
+  env->ReleaseStringUTFChars(result, chars);
+  env->DeleteLocalRef(result);
+  if (!found) {
+    Py_RETURN_NONE;
+  }
+  return Py_BuildValue("(sff)", kind, x, y);
+}
