# The back button (or a keyboard's own "hide the keyboard" button) while the
# keyboard is up only puts the keyboard away; it no longer reaches Android's
# own back handling, which sent the whole game to the background.
# Applies after android-text-input.patch and the other PythonActivity patches.
diff --git a/panda/src/android/PythonActivity.java b/panda/src/android/PythonActivity.java
index 42ea766..4cf806e 100644
--- a/panda/src/android/PythonActivity.java
+++ b/panda/src/android/PythonActivity.java
@@ -246,9 +246,7 @@ public class PythonActivity extends PandaActivity {
                 // The back button puts the keyboard away; the game is told,
                 // so that it does not bring it straight back.
                 if (event.getAction() == KeyEvent.ACTION_UP) {
-                    typingWanted = false;
-                    typingEvents.add("C:");
-                    stopTyping();
+                    closeKeyboardByBack();
                 }
                 return true;
             }
@@ -338,6 +336,17 @@ public class PythonActivity extends PandaActivity {
 
         @Override
         public boolean sendKeyEvent(KeyEvent event) {
+            if (event.getKeyCode() == KeyEvent.KEYCODE_BACK) {
+                // Some keyboards send their own "hide the keyboard" button
+                // (and the back button, when they look after it themselves)
+                // to the editor as a back key.  Passed on, it would skip
+                // onKeyPreIme and reach the activity, which sends the whole
