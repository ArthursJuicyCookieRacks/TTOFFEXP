+        // Turns what was composed into text: backspace over the letters of
+        // the old word that changed, then type the new word's.
+        private void replaceComposing(String text) {
+            int same = 0;
+            int most = Math.min(composing.length(), text.length());
+            while (same < most && composing.charAt(same) == text.charAt(same)) {
+                ++same;
+            }
+            if (same > 0 && Character.isHighSurrogate(composing.charAt(same - 1))) {
+                --same;
+            }
+            int erase = composing.codePointCount(same, composing.length());
+            for (int i = 0; i < erase; ++i) {
+                sendKey(KeyEvent.KEYCODE_DEL);
+            }
+            String typed = text.substring(same);
+            if (!typed.isEmpty()) {
