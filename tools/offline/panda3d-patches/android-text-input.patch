+/**
+ * Brings up the system's keyboard to type a line of text with;
+ * typed_text() gives the text when it is done.
+ */
+static PyObject *
+_py_ask_text(PyObject *self, PyObject *args) {
+  char *title;
+  char *text;
+  int max_length = 0;
+  if (!PyArg_ParseTuple(args, "ss|i", &title, &text, &max_length)) {
+    return NULL;
+  }
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "askText", "(Ljava/lang/String;Ljava/lang/String;I)V") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    PyErr_SetString(PyExc_NotImplementedError, "this activity has no keyboard support");
+    return NULL;
+  }
+  jstring jtitle = env->NewStringUTF(title);
+  jstring jtext = env->NewStringUTF(text);
+  env->CallVoidMethod(activity, method, jtitle, jtext, (jint)max_length);
+  env->DeleteLocalRef(jtitle);
+  env->DeleteLocalRef(jtext);
+  env->DeleteLocalRef(activity_class);
+  Py_RETURN_NONE;
+}
+
+/**
+ * Returns what is typed so far, after "E:" while typing, "S:" once sent or
+ * "C:" if the keyboard was closed.
+ */
+static PyObject *
+_py_typed_text(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "getTypedText", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    return PyUnicode_FromString("");
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (result == nullptr) {
+    Py_RETURN_NONE;
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  PyObject *text = PyUnicode_FromString(chars);
+  env->ReleaseStringUTFChars(result, chars);
+  env->DeleteLocalRef(result);
+  return text;
+}
