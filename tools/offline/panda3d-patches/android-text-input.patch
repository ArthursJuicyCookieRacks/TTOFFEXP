+    // Typing with the system's keyboard straight into the game's own text
+    // box. The game's window takes no typing from an on-screen keyboard, so
+    // an invisible text field takes it, and the game shows what it holds.
+    // getTypedText gives "E:" and the text while typing, "S:" and the text
+    // once it is sent, and "C:" and the text if the keyboard was closed.
+    private volatile String typedText = "C:";
+    private EditText hiddenEdit = null;
+
+    public void askText(String title, String text, int maxLength) {
+        // The state changes at once, on the game's thread: set later on the
+        // UI thread, the game could read the last time's "S:" or "C:" just
+        // after asking and take it as this time's (sending the last message
+        // again, or stopping before a word was typed).
+        if (maxLength < 0) {
+            typedText = "C:" + typedText.substring(2);
+        } else {
+            typedText = "E:" + text;
+        }
+        runOnUiThread(() -> {
+            if (maxLength < 0) {
+                // The game is done with the keyboard.
+                if (hiddenEdit != null) {
+                    closeKeyboard();
+                }
+                return;
+            }
+            if (hiddenEdit == null) {
+                hiddenEdit = new EditText(this) {
+                    @Override
+                    public boolean onKeyPreIme(int keyCode, KeyEvent event) {
+                        if (keyCode == KeyEvent.KEYCODE_BACK && event.getAction() == KeyEvent.ACTION_UP) {
+                            typedText = "C:" + getText().toString();
+                            closeKeyboard();
+                            return true;
+                        }
+                        return super.onKeyPreIme(keyCode, event);
+                    }
+
+                    // The game shows the text with no cursor, so the cursor
+                    // stays at the end: a controller's d-pad could move it
+                    // to the front, and then backspace deleted nothing.
+                    @Override
+                    protected void onSelectionChanged(int selStart, int selEnd) {
+                        int end = getText() != null ? getText().length() : 0;
+                        if (selStart != end || selEnd != end) {
+                            setSelection(end);
+                            return;
+                        }
+                        super.onSelectionChanged(selStart, selEnd);
+                    }
+                };
+                hiddenEdit.setSingleLine(true);
+                hiddenEdit.setAlpha(0.0f);
+                hiddenEdit.setImeOptions(EditorInfo.IME_ACTION_SEND | EditorInfo.IME_FLAG_NO_EXTRACT_UI |
+                                         EditorInfo.IME_FLAG_NO_FULLSCREEN);
+                hiddenEdit.addTextChangedListener(new TextWatcher() {
+                    public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+                    public void onTextChanged(CharSequence s, int start, int before, int count) {}
+                    public void afterTextChanged(Editable s) {
+                        if (typedText.startsWith("E:")) {
+                            typedText = "E:" + s.toString();
+                        }
+                    }
+                });
+                // While the game wants typing, the field keeps the focus: the
+                // game's surface could take it back (a touch on the screen),
+                // and then the keyboard typed into nothing and its backspace
+                // went to the game as a key, deleting from the game's box
+                // but not from this field.
+                hiddenEdit.setOnFocusChangeListener((view, hasFocus) -> {
+                    if (!hasFocus && typedText.startsWith("E:")) {
+                        view.post(() -> {
+                            if (hiddenEdit != null && typedText.startsWith("E:") && !hiddenEdit.isFocused()) {
+                                hiddenEdit.setFocusable(true);
+                                hiddenEdit.setFocusableInTouchMode(true);
+                                hiddenEdit.requestFocus();
+                                InputMethodManager imm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+                                if (imm != null) {
+                                    imm.showSoftInput(hiddenEdit, 0);
+                                }
+                            }
+                        });
+                    }
+                });
+                hiddenEdit.setOnEditorActionListener((view, action, event) -> {
+                    typedText = "S:" + hiddenEdit.getText().toString();
+                    closeKeyboard();
+                    return true;
+                });
+                addContentView(hiddenEdit, new ViewGroup.LayoutParams(1, 1));
+            }
+            if (maxLength > 0) {
+                hiddenEdit.setFilters(new InputFilter[] { new InputFilter.LengthFilter(maxLength) });
+            } else {
+                hiddenEdit.setFilters(new InputFilter[0]);
+            }
+            typedText = "E:" + text;
+            hiddenEdit.setText(text);
+            hiddenEdit.setSelection(hiddenEdit.getText().length());
+            hiddenEdit.setFocusable(true);
+            hiddenEdit.setFocusableInTouchMode(true);
+            // A field made just now is not in the window yet: the keyboard
+            // asked for at once would come up bound to the game's surface,
+            // which takes no typing, and nothing typed would arrive until
+            // the field was asked for again. So the field gets the focus
+            // once it is attached, the keyboard is bound to it in so many
+            // words, and both are asked for again once things have
+            // settled, since the game's surface can take the focus back.
+            Runnable takeFocus = () -> {
+                if (hiddenEdit != null && typedText.startsWith("E:")) {
+                    hiddenEdit.requestFocus();
+                    showKeyboard();
+                }
+            };
+            hiddenEdit.post(takeFocus);
+            hiddenEdit.postDelayed(takeFocus, 250);
+            hiddenEdit.postDelayed(takeFocus, 700);
+        });
+    }
+
+    // The game's box changed some other way (a key from a hardware keyboard,
+    // the game clearing it): the field takes the same text, so the next
+    // letter typed does not bring back what the box no longer holds.
+    public void setTypedText(String text) {
+        if (!typedText.startsWith("E:")) {
+            return;
+        }
+        typedText = "E:" + text;
+        runOnUiThread(() -> {
+            if (hiddenEdit != null && typedText.startsWith("E:") && !hiddenEdit.getText().toString().equals(text)) {
+                hiddenEdit.setText(text);
+                hiddenEdit.setSelection(hiddenEdit.getText().length());
+            }
+        });
+    }
+
+    private void showKeyboard() {
+        InputMethodManager imm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+        if (imm != null && hiddenEdit != null) {
+            if (!hiddenEdit.isFocused()) {
+                hiddenEdit.requestFocus();
+            }
+            imm.restartInput(hiddenEdit);
+            imm.showSoftInput(hiddenEdit, InputMethodManager.SHOW_FORCED);
+        }
+    }
+
+    private void closeKeyboard() {
+        InputMethodManager imm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+        if (imm != null) {
+            imm.hideSoftInputFromWindow(hiddenEdit.getWindowToken(), 0);
+        }
+        // The field stays in the window, ready for the next time, but can
+        // hold no focus until then: left focusable it would keep it (Android
+        // gives the focus straight back to the only field there is), and a
+        // controller's buttons would go to the keyboard instead of the game
+        // until the screen was touched.
+        hiddenEdit.clearFocus();
+        hiddenEdit.setFocusable(false);
+        hiddenEdit.setFocusableInTouchMode(false);
+    }
+
+    public String getTypedText() {
+        return typedText;
+    }
