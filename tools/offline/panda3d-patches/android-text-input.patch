+/**
+ * The character that a key types, or 0 if it types none.  Java's
+ * KeyCharacterMap knows it; the NDK has no call for it.
+ */
+static int
+get_key_character(const AInputEvent *event) {
+  JNIEnv *env = Thread::get_current_thread()->get_jni_env();
+  if (env == nullptr) {
+    return 0;
+  }
+  static jclass map_class = nullptr;
+  static jmethodID load_method = nullptr;
+  static jmethodID get_method = nullptr;
+  if (map_class == nullptr) {
+    jclass local_class = env->FindClass("android/view/KeyCharacterMap");
+    if (local_class == nullptr) {
+      env->ExceptionClear();
+      return 0;
+    }
+    load_method = env->GetStaticMethodID(local_class, "load", "(I)Landroid/view/KeyCharacterMap;");
+    get_method = env->GetMethodID(local_class, "get", "(II)I");
+    if (load_method == nullptr || get_method == nullptr) {
+      env->ExceptionClear();
+      env->DeleteLocalRef(local_class);
+      return 0;
+    }
+    map_class = (jclass)env->NewGlobalRef(local_class);
+    env->DeleteLocalRef(local_class);
+  }
+  jobject map = env->CallStaticObjectMethod(map_class, load_method, (jint)AInputEvent_getDeviceId(event));
+  if (env->ExceptionCheck()) {
+    // A device that is gone.
+    env->ExceptionClear();
+    map = nullptr;
+  }
+  if (map == nullptr) {
+    return 0;
+  }
+  jint ch = env->CallIntMethod(map, get_method, (jint)AKeyEvent_getKeyCode(event),
+                               (jint)AKeyEvent_getMetaState(event));
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    ch = 0;
+  }
+  env->DeleteLocalRef(map);
+  // Control characters (Enter, backspace) are keys, not text, and a dead
+  // key (an accent for the next letter; the top bit is set) types nothing.
+  if (ch < 32 || ch == 127) {
+    return 0;
+  }
+  return ch;
+}
+
+/**
+ * Types the text that the activity's keyboard editor queued up: a phone's
+ * keyboard hands over most of what it types as text, not as keys, and the
+ * editor sends a key with no key code to stand for each piece, so that the
+ * text arrives here in its place among the other keys (such as backspace).
+ */
+static void
+type_queued_text(struct android_app *app, GraphicsWindowInputDevice *input) {
+  JNIEnv *env = Thread::get_current_thread()->get_jni_env();
+  if (env == nullptr || app == nullptr || app->activity == nullptr) {
+    return;
+  }
+  jobject activity = app->activity->clazz;
+  jclass activity_class = env->GetObjectClass(activity);
+  jmethodID method = env->GetMethodID(activity_class, "takeTypedText", "()Ljava/lang/String;");
+  env->DeleteLocalRef(activity_class);
+  if (method == nullptr) {
+    env->ExceptionClear();
+    return;
+  }
+  jstring text = (jstring)env->CallObjectMethod(activity, method);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    return;
+  }
+  if (text == nullptr) {
+    return;
+  }
+  // Java's strings are UTF-16: a pair of surrogates is one character.
+  jsize length = env->GetStringLength(text);
+  const jchar *chars = env->GetStringChars(text, nullptr);
+  if (chars != nullptr) {
+    for (jsize i = 0; i < length; ++i) {
+      int ch = chars[i];
+      if (ch >= 0xd800 && ch < 0xdc00 && i + 1 < length &&
+          chars[i + 1] >= 0xdc00 && chars[i + 1] < 0xe000) {
+        ch = 0x10000 + ((ch - 0xd800) << 10) + (chars[i + 1] - 0xdc00);
+        ++i;
+      }
+      if (ch >= 32 && ch != 127) {
+        input->keystroke(ch);
+      }
+    }
+    env->ReleaseStringChars(text, chars);
+  }
+  env->DeleteLocalRef(text);
+}
