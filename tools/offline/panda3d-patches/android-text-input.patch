+/**
+ * Brings up the system's keyboard (show_keyboard(True)), or puts it away.
+ * What is typed with it reaches the game's window as typed keys, as a
+ * computer's keyboard's would.
+ */
+static PyObject *
+_py_show_keyboard(PyObject *self, PyObject *args) {
+  int show = 1;
+  if (!PyArg_ParseTuple(args, "|p", &show)) {
+    return NULL;
+  }
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "showKeyboard", "(Z)V") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+      env->DeleteLocalRef(activity_class);
+    }
+    PyErr_SetString(PyExc_NotImplementedError, "this activity has no keyboard support");
+    return NULL;
+  }
+  env->CallVoidMethod(activity, method, (jboolean)(show ? JNI_TRUE : JNI_FALSE));
+  env->DeleteLocalRef(activity_class);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+  }
+  Py_RETURN_NONE;
+}
+
+/**
+ * Returns "C:" once for each time the player put the keyboard away (the
+ * back button), or "" if there is no news.
+ */
+static PyObject *
+_py_poll_keyboard(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "pollKeyboard", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+      env->DeleteLocalRef(activity_class);
+    }
+    return PyUnicode_FromString("");
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (env->ExceptionCheck()) {
+    env->ExceptionClear();
+    result = nullptr;
+  }
+  if (result == nullptr) {
+    return PyUnicode_FromString("");
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  PyObject *text = PyUnicode_FromString(chars != nullptr ? chars : "");
+  if (chars != nullptr) {
+    env->ReleaseStringUTFChars(result, chars);
+  }
+  env->DeleteLocalRef(result);
+  return text;
+}
