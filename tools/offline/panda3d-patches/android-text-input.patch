+    // Typing a line of text with the system's keyboard, in a small dialog
+    // (the game's own window takes no typing from an on-screen keyboard).
+    // typedText is null while the dialog is open, and then what was typed,
+    // or "" if it was cancelled.
+    private volatile String typedText = "";
+
+    public void askText(String title, String text, int maxLength) {
+        typedText = null;
+        runOnUiThread(() -> {
+            final EditText edit = new EditText(this);
+            edit.setSingleLine(true);
+            edit.setImeOptions(EditorInfo.IME_ACTION_SEND | EditorInfo.IME_FLAG_NO_EXTRACT_UI);
+            if (maxLength > 0) {
+                edit.setFilters(new android.text.InputFilter[] {
+                    new android.text.InputFilter.LengthFilter(maxLength) });
+            }
+            edit.setText(text);
+            edit.setSelection(edit.getText().length());
+            final AlertDialog dialog = new AlertDialog.Builder(this)
+                .setTitle(title)
+                .setView(edit)
+                .setPositiveButton("Send", (d, which) -> typedText = edit.getText().toString())
+                .setNegativeButton("Cancel", (d, which) -> typedText = "")
+                .setOnCancelListener(d -> typedText = "")
+                .create();
+            edit.setOnEditorActionListener((view, action, event) -> {
+                typedText = edit.getText().toString();
+                dialog.dismiss();
+                return true;
+            });
+            dialog.setOnDismissListener(d -> {
+                if (typedText == null) {
+                    typedText = "";
+                }
+            });
+            dialog.getWindow().setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_VISIBLE);
+            dialog.show();
+            edit.requestFocus();
+        });
+    }
+
+    public String getTypedText() {
+        return typedText;
+    }
+
