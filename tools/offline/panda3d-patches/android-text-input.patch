+                StringBuilder letters = new StringBuilder();
+                for (int i = 0; i < typed.length(); ++i) {
+                    char c = typed.charAt(i);
+                    if (c == '\n' || c == '\r') {
+                        typeLetters(letters);
+                        sendKey(KeyEvent.KEYCODE_ENTER);
+                    } else {
+                        letters.append(c);
+                    }
+                }
+                typeLetters(letters);
+            }
+            composing = text;
+        }
