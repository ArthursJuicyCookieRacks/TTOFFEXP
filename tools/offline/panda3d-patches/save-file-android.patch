+/**
+ * Opens the system's "save as" screen to save a copy of the given file.
+ * saved_file() says when it is done.
+ */
+static PyObject *
+_py_save_file(PyObject *self, PyObject *args) {
+  char *source_path;
+  char *mime_type;
+  char *name;
+  if (!PyArg_ParseTuple(args, "sss", &source_path, &mime_type, &name)) {
+    return NULL;
+  }
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "saveFile", "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    PyErr_SetString(PyExc_NotImplementedError, "this activity cannot save files");
+    return NULL;
+  }
+  jstring jsource_path = env->NewStringUTF(source_path);
+  jstring jmime_type = env->NewStringUTF(mime_type);
+  jstring jname = env->NewStringUTF(name);
+  env->CallVoidMethod(activity, method, jsource_path, jmime_type, jname);
+  env->DeleteLocalRef(jsource_path);
+  env->DeleteLocalRef(jmime_type);
+  env->DeleteLocalRef(jname);
+  env->DeleteLocalRef(activity_class);
+  Py_RETURN_NONE;
+}
+
+/**
+ * Returns None while the "save as" screen is open, "" if nothing was saved,
+ * or else the name the file was saved under.
+ */
+static PyObject *
+_py_saved_file(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "getSavedFile", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    return PyUnicode_FromString("");
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (result == nullptr) {
+    Py_RETURN_NONE;
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  PyObject *saved = PyUnicode_FromString(chars);
+  env->ReleaseStringUTFChars(result, chars);
+  env->DeleteLocalRef(result);
+  return saved;
+}
