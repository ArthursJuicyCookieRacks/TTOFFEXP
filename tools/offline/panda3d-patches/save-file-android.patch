+    // Saving one of the game's files somewhere the player picks with the
+    // system's "save as" screen (for toon backups that must outlive the
+    // app).  savedFile is null while that screen is open, "" if nothing was
+    // saved, and otherwise the name the file was saved under.
+    private static final int SAVE_FILE_REQUEST = 0x7d02;
+    private volatile String savedFile = "";
+    private volatile String saveSource = null;
+
+    public void saveFile(String sourcePath, String mimeType, String name) {
+        savedFile = null;
+        saveSource = sourcePath;
+        runOnUiThread(() -> {
+            Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType(mimeType);
+            intent.putExtra(Intent.EXTRA_TITLE, name);
+            try {
+                startActivityForResult(intent, SAVE_FILE_REQUEST);
+            } catch (Exception e) {
+                savedFile = "";
+            }
+        });
+    }
+
+    public String getSavedFile() {
+        return savedFile;
+    }
+
+    private void writeSavedFile(Uri uri) {
+        String name = "saved";
+        try (Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                int column = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (column >= 0 && cursor.getString(column) != null) {
+                    name = cursor.getString(column);
+                }
+            }
+        } catch (Exception e) {
+        }
+        try (InputStream in = new FileInputStream(saveSource);
+             OutputStream out = getContentResolver().openOutputStream(uri)) {
+            byte[] buffer = new byte[65536];
+            int count;
+            while ((count = in.read(buffer)) > 0) {
+                out.write(buffer, 0, count);
+            }
+            out.flush();
+            savedFile = name;
+        } catch (Exception e) {
+            savedFile = "";
+        }
+    }
+
     @Override
     protected void onActivityResult(int requestCode, int resultCode, Intent intent) {
+        if (requestCode == SAVE_FILE_REQUEST) {
+            if (resultCode == RESULT_OK && intent != null && intent.getData() != null) {
+                Uri uri = intent.getData();
+                new Thread(() -> writeSavedFile(uri)).start();
+            } else {
+                savedFile = "";
+            }
+            return;
+        }
