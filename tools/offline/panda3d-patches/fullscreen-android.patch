+    // The game takes the whole screen: no status bar (clock, signal,
+    // battery) and no navigation bar.  A swipe from the edge shows them for
+    // a moment.  Android shows them again after a dialog or a trip out of
+    // the app, so this is redone each time the game gets the focus back.
+    // The screen also stays on while the game is open: no dimming and no
+    // sleep between touches (a controller player may not touch it at all).
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        if (Build.VERSION.SDK_INT >= 28) {
+            // Draw under the camera notch too.  Panda builds against an
+            // old SDK, so the field (LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
+            // = 1, added in API 28) is set by name.
+            WindowManager.LayoutParams params = getWindow().getAttributes();
+            try {
+                params.getClass().getField("layoutInDisplayCutoutMode").setInt(params, 1);
+                getWindow().setAttributes(params);
+            } catch (Exception e) {
+            }
+        }
+        hideSystemBars();
+    }
+
+    @Override
+    public void onWindowFocusChanged(boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus) {
+            hideSystemBars();
+        }
+    }
+
+    @SuppressWarnings("deprecation")
+    private void hideSystemBars() {
+        getWindow().getDecorView().setSystemUiVisibility(
+            View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY |
+            View.SYSTEM_UI_FLAG_FULLSCREEN |
+            View.SYSTEM_UI_FLAG_HIDE_NAVIGATION |
+            View.SYSTEM_UI_FLAG_LAYOUT_STABLE |
+            View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN |
+            View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION);
+    }
+
