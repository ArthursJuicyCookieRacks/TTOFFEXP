+++ b/pandatool/src/deploy-stub/android_support.cxx
@@ -53,9 +53,85 @@ _py_find_library(PyObject *self, PyObject *args) {
   return NULL;
 }
 
+/**
+ * Returns the JNI environment of this thread, and the activity.
+ */
+static JNIEnv *
+get_activity_env(jobject &activity, jclass &activity_class) {
+  JNIEnv *env = nullptr;
+  ANativeActivity *native = panda_android_app->activity;
+  if (native->vm->AttachCurrentThread(&env, nullptr) != 0 || env == nullptr) {
+    return nullptr;
+  }
+  activity = native->clazz;
+  activity_class = env->GetObjectClass(activity);
+  return env;
+}
+
+/**
+ * Opens the system's file picker.  The picked file is copied into the given
+ * folder; picked_file() says when it is there.
+ */
+static PyObject *
+_py_pick_file(PyObject *self, PyObject *args) {
+  char *mime_type;
+  char *dest_dir;
+  if (!PyArg_ParseTuple(args, "ss", &mime_type, &dest_dir)) {
+    return NULL;
+  }
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "pickFile", "(Ljava/lang/String;Ljava/lang/String;)V") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    PyErr_SetString(PyExc_NotImplementedError, "this activity has no file picker");
+    return NULL;
+  }
+  jstring jmime_type = env->NewStringUTF(mime_type);
+  jstring jdest_dir = env->NewStringUTF(dest_dir);
+  env->CallVoidMethod(activity, method, jmime_type, jdest_dir);
+  env->DeleteLocalRef(jmime_type);
+  env->DeleteLocalRef(jdest_dir);
+  env->DeleteLocalRef(activity_class);
+  Py_RETURN_NONE;
+}
+
+/**
+ * Returns None while the file picker is open, "" if nothing was picked, or
+ * else the path of the copy of the picked file.
+ */
+static PyObject *
+_py_picked_file(PyObject *self, PyObject *args) {
+  jobject activity;
+  jclass activity_class;
+  JNIEnv *env = get_activity_env(activity, activity_class);
+  jmethodID method = env ? env->GetMethodID(activity_class, "getPickedFile", "()Ljava/lang/String;") : nullptr;
+  if (method == nullptr) {
+    if (env != nullptr) {
+      env->ExceptionClear();
+    }
+    return PyUnicode_FromString("");
+  }
+  jstring result = (jstring)env->CallObjectMethod(activity, method);
+  env->DeleteLocalRef(activity_class);
+  if (result == nullptr) {
+    Py_RETURN_NONE;
+  }
+  const char *chars = env->GetStringUTFChars(result, nullptr);
+  PyObject *path = PyUnicode_FromString(chars);
+  env->ReleaseStringUTFChars(result, chars);
+  env->DeleteLocalRef(result);
+  return path;
+}
+
 static PyMethodDef python_simple_funcs[] = {
   { "log_write", &_py_log_write, METH_VARARGS },
   { "find_library", &_py_find_library, METH_VARARGS },
+  { "pick_file", &_py_pick_file, METH_VARARGS },
+  { "picked_file", &_py_picked_file, METH_NOARGS },
   { NULL, NULL }
 };
 
