 import java.util.ArrayList;
 import java.util.Collections;
 import java.util.Iterator;
@@ -54,8 +61,70 @@ public class PythonActivity extends PandaActivity {
         this.activityResultListeners.remove(listener);
     }
 
+    // Picking a file with the system's file picker, for the game to copy
+    // into its own folder.  pickedFile is null while the picker is open, ""
+    // if nothing was picked, and otherwise the path of the copy.
+    private static final int PICK_FILE_REQUEST = 0x7d01;
+    private volatile String pickedFile = "";
+    private volatile String pickDir = null;
+
+    public void pickFile(String mimeType, String destDir) {
+        pickedFile = null;
+        pickDir = destDir;
+        runOnUiThread(() -> {
+            Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            intent.setType(mimeType);
+            try {
+                startActivityForResult(intent, PICK_FILE_REQUEST);
+            } catch (Exception e) {
+                pickedFile = "";
+            }
+        });
+    }
+
+    public String getPickedFile() {
+        return pickedFile;
+    }
+
+    private void copyPickedFile(Uri uri) {
+        String name = "picked";
+        try (Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) {
+                int column = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (column >= 0 && cursor.getString(column) != null) {
+                    name = new File(cursor.getString(column)).getName();
+                }
+            }
+        } catch (Exception e) {
+        }
+        File dir = new File(pickDir);
+        dir.mkdirs();
+        File dest = new File(dir, name);
+        try (InputStream in = getContentResolver().openInputStream(uri);
+             OutputStream out = new FileOutputStream(dest)) {
+            byte[] buffer = new byte[65536];
+            int count;
+            while ((count = in.read(buffer)) > 0) {
+                out.write(buffer, 0, count);
+            }
+            pickedFile = dest.getAbsolutePath();
+        } catch (Exception e) {
+            pickedFile = "";
+        }
+    }
+
     @Override
     protected void onActivityResult(int requestCode, int resultCode, Intent intent) {
+        if (requestCode == PICK_FILE_REQUEST) {
+            if (resultCode == RESULT_OK && intent != null && intent.getData() != null) {
+                Uri uri = intent.getData();
+                new Thread(() -> copyPickedFile(uri)).start();
+            } else {
+                pickedFile = "";
+            }
+            return;
+        }
         if (this.activityResultListeners == null) {
             return;
         }
diff --git a/pandatool/src/deploy-stub/android_support.cxx b/pandatool/src/deploy-stub/android_support.cxx
