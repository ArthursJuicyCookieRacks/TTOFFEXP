+/*
+ * Zink can draw straight into an Android window through Vulkan (kopper),
+ * with no DRM device or gralloc in between.  This lets an app run GLES on a
+ * Vulkan driver of its choosing.
+ */
+static _EGLSurface *
+surfaceless_kopper_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                                         void *native_window,
+                                         const EGLint *attrib_list)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   struct dri2_egl_config *dri2_conf = dri2_egl_config(conf);
+   struct ANativeWindow *window = native_window;
+   struct dri2_egl_surface *dri2_surf;
+   const struct dri_config *config;
+
+   if (!window) {
+      _eglError(EGL_BAD_NATIVE_WINDOW, "eglCreateWindowSurface");
+      return NULL;
+   }
+
+   dri2_surf = calloc(1, sizeof *dri2_surf);
+   if (!dri2_surf) {
+      _eglError(EGL_BAD_ALLOC, "eglCreateWindowSurface");
+      return NULL;
+   }
+
+   if (!dri2_init_surface(&dri2_surf->base, disp, EGL_WINDOW_BIT, conf,
+                          attrib_list, false, native_window))
+      goto cleanup_surface;
+
+   dri2_surf->base.Width = ANativeWindow_getWidth(window);
+   dri2_surf->base.Height = ANativeWindow_getHeight(window);
+
+   config = dri2_get_dri_config(dri2_conf, EGL_WINDOW_BIT,
+                                dri2_surf->base.GLColorspace);
+   if (!config) {
+      _eglError(EGL_BAD_MATCH,
+                "Unsupported surfacetype/colorspace configuration");
+      goto cleanup_surface;
+   }
+
+   ANativeWindow_acquire(window);
+   if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf)) {
+      ANativeWindow_release(window);
+      goto cleanup_surface;
+   }
+
+   dri2_surf->base.SwapInterval = 1;
+   kopperSetSwapInterval(dri2_surf->dri_drawable,
+                         dri2_dpy->default_swap_interval);
+   dri2_surf->base.SwapInterval = dri2_dpy->default_swap_interval;
+
+   return &dri2_surf->base;
+
+cleanup_surface:
+   free(dri2_surf);
+   return NULL;
+}
+
+static EGLBoolean
+surfaceless_kopper_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+
+   kopperSwapBuffers(dri2_surf->dri_drawable,
+                     __DRI2_FLUSH_INVALIDATE_ANCILLARY);
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+surfaceless_kopper_swap_interval(_EGLDisplay *disp, _EGLSurface *surf,
+                                 EGLint interval)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   if (surf->Type == EGL_WINDOW_BIT)
+      kopperSetSwapInterval(dri2_surf->dri_drawable, interval);
+   return EGL_TRUE;
+}
+
+static EGLint
+surfaceless_kopper_query_buffer_age(_EGLDisplay *disp, _EGLSurface *surf)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   if (surf->Type != EGL_WINDOW_BIT)
+      return 0;
+   return kopperQueryBufferAge(dri2_surf->dri_drawable);
+}
+
+static const struct dri2_egl_display_vtbl dri2_surfaceless_android_display_vtbl = {
+   .create_window_surface = surfaceless_kopper_create_window_surface,
+   .create_pbuffer_surface = dri2_surfaceless_create_pbuffer_surface,
+   .destroy_surface = surfaceless_destroy_surface,
+   .create_image = dri2_create_image_khr,
+   .swap_interval = surfaceless_kopper_swap_interval,
+   .swap_buffers = surfaceless_kopper_swap_buffers,
+   .query_buffer_age = surfaceless_kopper_query_buffer_age,
+   .get_dri_drawable = dri2_surface_get_dri_drawable,
+};
+
+static_assert(sizeof(struct kopper_vk_surface_create_storage) >=
+                 sizeof(VkAndroidSurfaceCreateInfoKHR),
+              "");
+
+static void
+surfaceless_kopper_set_surface_create_info(void *_draw,
+                                           struct kopper_loader_info *out)
+{
+   struct dri2_egl_surface *dri2_surf = _draw;
+   VkAndroidSurfaceCreateInfoKHR *asci =
+      (VkAndroidSurfaceCreateInfoKHR *)&out->bos;
+
+   /* A pbuffer has no surface. */
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return;
+
+   asci->sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+   asci->pNext = NULL;
+   asci->flags = 0;
+   asci->window = dri2_surf->base.NativeSurface;
+   out->present_opaque = dri2_surf->base.PresentOpaque;
+}
+
+static void
+surfaceless_kopper_get_drawable_info(struct dri_drawable *draw, int *w,
+                                     int *h, void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   if (dri2_surf->base.Type == EGL_WINDOW_BIT &&
+       dri2_surf->base.NativeSurface) {
+      struct ANativeWindow *window = dri2_surf->base.NativeSurface;
+      int width = ANativeWindow_getWidth(window);
+      int height = ANativeWindow_getHeight(window);
+      if (width > 0 && height > 0) {
+         dri2_surf->base.Width = width;
+         dri2_surf->base.Height = height;
+      }
+   }
+   *w = dri2_surf->base.Width;
+   *h = dri2_surf->base.Height;
+}
+
+static const __DRIkopperLoaderExtension kopper_android_loader_extension = {
+   .base = {__DRI_KOPPER_LOADER, 1},
+   .SetSurfaceCreateInfo = surfaceless_kopper_set_surface_create_info,
+   .GetDrawableInfo = surfaceless_kopper_get_drawable_info,
+};
+
+static const __DRIextension *kopper_android_loader_extensions[] = {
+   &kopper_android_loader_extension.base, &image_lookup_extension.base, NULL,
+};
+
+static void
+surfaceless_kopper_add_window_configs(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   static const struct {
+      int window_format;
+      enum pipe_format pipe_format;
+   } visuals[] = {
+      {WINDOW_FORMAT_RGBA_8888, PIPE_FORMAT_RGBA8888_UNORM},
+      {WINDOW_FORMAT_RGBX_8888, PIPE_FORMAT_RGBX8888_UNORM},
+      {WINDOW_FORMAT_RGB_565, PIPE_FORMAT_B5G6R5_UNORM},
+   };
+
+   for (unsigned i = 0; i < ARRAY_SIZE(visuals); i++) {
+      for (unsigned j = 0; dri2_dpy->driver_configs[j]; j++) {
+         const struct gl_config *gl_config =
+            (struct gl_config *)dri2_dpy->driver_configs[j];
+         if (util_format_linear(gl_config->color_format) !=
+             visuals[i].pipe_format)
+            continue;
+
+         const EGLint config_attrs[] = {
+            EGL_NATIVE_VISUAL_ID, visuals[i].window_format,
+            EGL_NATIVE_VISUAL_TYPE, visuals[i].window_format,
+            EGL_NONE,
+         };
+         dri2_add_config(disp, dri2_dpy->driver_configs[j],
+                         EGL_WINDOW_BIT | EGL_PBUFFER_BIT, config_attrs);
+      }
+   }
+}
